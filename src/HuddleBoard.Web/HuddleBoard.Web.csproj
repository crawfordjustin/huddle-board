<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>HuddleBoard.Web</RootNamespace>
    <HuddleBoardDeploy>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\..\dist\deploy'))</HuddleBoardDeploy>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HuddleBoard.Playbook\HuddleBoard.Playbook.csproj" />
  </ItemGroup>

  <!--
    Publishing has to carry the built site with it, because a published app has
    no repository above it to read dist/ from. Build the app first, then stage
    dist/deploy into wwwroot. The items are added inside the target because the
    folder does not exist at evaluation time; the base path is normalised and the
    glob is flat, because `**` over a base containing `..` matches every file
    twice, and two entries for one relative path is a hard error.

    The app is staged into wwwroot/app, because the site owns the root. The
    static-host config is left behind: this host applies those rules itself, and
    a nested IIS web.config under an ASP.NET Core app is a conflict waiting to
    happen. dist/deploy itself is untouched and still a complete static site.
  -->
  <!--
    SkiaSharp ships native debug symbols at 86 MB a platform, and a published
    site never draws with it — it only renders icons during `build`, which a
    published site does not run. Packages' symbols are left out; ours stay.
    Without this the package outgrew the App Service's disk.
  -->
  <Target Name="DropPackageSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Extension)' == '.pdb' and '%(ResolvedFileToPublish.NuGetPackageId)' != ''" />
    </ItemGroup>
  </Target>

  <Target Name="BuildHuddleBoardSite" BeforeTargets="ComputeFilesToPublish"
          Condition="'$(_HuddleBoardSiteStaged)' != 'true'">
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\HuddleBoard.Build&quot; -- build"
          WorkingDirectory="$(MSBuildThisFileDirectory)" />
    <PropertyGroup>
      <_HuddleBoardSiteStaged>true</_HuddleBoardSiteStaged>
    </PropertyGroup>
    <ItemGroup>
      <HuddleBoardSiteFile Include="$(HuddleBoardDeploy)*"
                           Exclude="$(HuddleBoardDeploy)web.config;$(HuddleBoardDeploy)staticwebapp.config.json;$(HuddleBoardDeploy)_headers;$(HuddleBoardDeploy)README.md" />
      <ResolvedFileToPublish Include="@(HuddleBoardSiteFile)">
        <RelativePath>wwwroot\app\%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
